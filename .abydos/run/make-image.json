{
  "args" : [
    "-from",
    "out/rootfs_arm64_full",
    "-out",
    "out/abydos-devpod-arm64-full.tar",
    "-tag",
    "pharndt/abydos-devpod:dev",
    "-arch",
    "arm64",
    "-env",
    "ABYDOS_BINARY=/app/current,ABYDOS_WORKDIR=/app,ABYDOS_CONTROL_ADDR=:7999,ABYDOS_DEBUG_ADDR=:2345,ABYDOS_DLV=/usr/local/bin/dlv,ABYDOS_JAVA=/opt/java/bin/java,SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"
  ],
  "cwd" : "${workspaceFolder}/DevPod",
  "abydos.make" : {
    "directory" : "${workspaceFolder}/DevPod",
    "targets" : [
      "rootfs"
    ]
  },
  "name" : "make image",
  "program" : "${workspaceFolder}/DevPod",
  "request" : "launch",
  "type" : "go"
}
