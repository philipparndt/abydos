{
  "args" : [
    "-push",
    "pharndt/abydos-devpod:dev",
    "$(foreach",
    "-env",
    "ABYDOS_BINARY=/app/current,ABYDOS_WORKDIR=/app,ABYDOS_CONTROL_ADDR=:7999,ABYDOS_DEBUG_ADDR=:2345,ABYDOS_DLV=/usr/local/bin/dlv,SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"
  ],
  "cwd" : "${workspaceFolder}/DevPod",
  "name" : "make publish",
  "program" : "${workspaceFolder}/DevPod",
  "request" : "launch",
  "type" : "go"
}
