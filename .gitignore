# SPM build output
.build/
.swiftpm/

# Assembled .app bundle (Scripts/bundle.sh)
build/

# Xcode
*.xcodeproj
*.xcworkspace
DerivedData/

.DS_Store

# NOTE: Sources/Grammars/ is vendored on purpose and must stay committed.
# See Package.swift and Scripts/vendor-grammars.sh for why.

# Intermediate for the .icns; the icns itself is committed.
Resources/Icon/*.iconset/

# The DOOM-fire benchmark binary, kept here to run against the terminal.
# Built from github.com/const-void/DOOM-fire-zig; not ours to commit.
DOOM-fire
DevPod/out/

# Worktrees this editor's agent sessions create, each a full checkout with a
# build directory of its own. 6 GB of them here the day this was added, one
# `git add -A` away from being committed.
#
# The directory rather than everything under it, which `.claude/` used to be:
# the skills and commands beside them are four small files that describe how to
# work this repository, and they are worth exactly as much to the next person
# as they are to the machine that generated them. `abydos-backlog init` writes
# them, and an ignored copy is one that only ever exists where it was written.
.claude/worktrees/
.claude/settings.local.json
