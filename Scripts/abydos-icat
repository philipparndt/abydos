#!/bin/sh
# Prints an image in the terminal, using the kitty graphics protocol.
#
# The terminal in this app draws pictures on the character grid; nothing on a
# Mac ships a command that asks it to. kitty's own `icat` comes with kitty,
# `chafa` and `timg` draw with blocks instead, and a one-liner with `base64`
# is the sort of thing nobody remembers twice.
#
#   abydos-icat picture.png            print it
#   abydos-icat -w 40 picture.jpg      forty columns wide
#   abydos-icat *.png                  one after another
#
# Anything that is not a PNG is converted with `sips`, which every Mac has.
#
# Inside tmux the escape has to be wrapped so tmux hands it through rather than
# eating it, and tmux needs `allow-passthrough on` — which this says, once,
# when it is not set.
set -eu

width=""
height=""

usage() {
	cat >&2 <<'USAGE'
usage: abydos-icat [-w columns] [-h rows] <image> [image ...]

  -w  width in terminal columns  (default: the image's own size)
  -h  height in terminal rows
USAGE
	exit 2
}

while getopts "w:h:" option; do
	case "$option" in
		w) width="$OPTARG" ;;
		h) height="$OPTARG" ;;
		*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ "$#" -gt 0 ] || usage

# tmux eats an escape sequence it does not know unless it is wrapped in its own
# passthrough, and refuses to pass anything through at all unless told to.
in_tmux() { [ -n "${TMUX:-}" ]; }

if in_tmux; then
	if [ "$(tmux show -Apv allow-passthrough 2>/dev/null || echo off)" = "off" ]; then
		echo "abydos-icat: tmux is not passing escapes through; run:" >&2
		echo "    tmux set -p allow-passthrough on" >&2
		echo "  (or put 'set -g allow-passthrough on' in ~/.tmux.conf)" >&2
	fi
fi

esc=$(printf '\033')

# The placeholder cells are written by python3: a POSIX shell has no way to
# emit a codepoint by number — `printf '\u0305'` is not in bash 3.2, which is
# what /bin/sh is here — and the diacritics are three-byte sequences nobody
# should be pasting into a script by hand. Xcode's command line tools put one
# at /usr/bin, so this is only ever missing on a Mac with no developer tools at
# all.
PYTHON=$(command -v python3 2>/dev/null || true)
[ -n "$PYTHON" ] || PYTHON=/usr/bin/python3
if [ ! -x "$PYTHON" ]; then
	echo "abydos-icat: python3 is needed to draw the image and was not found" >&2
	exit 1
fi

# How large one character cell is, in pixels, and how wide the terminal is.
#
# A picture is placed on the character grid, so this is what turns "1000 pixels
# wide" into a number of columns. Without it the only thing left is a guess, and
# the guess was that a column is a pixel — which printed a picture followed by
# five hundred blank lines.
#
# The pty carries it: the same ioctl that reports rows and columns reports the
# window in pixels too. Where it does not — an older tmux, or a terminal that
# never filled it in — the terminal is asked directly, which is what the
# protocol provides `CSI 16 t` for.
cell_w=0
cell_h=0
term_columns=0
term_rows=0

read_winsize() {
	"$PYTHON" - <<'PY' 2>/dev/null
import fcntl, struct, sys, termios
try:
	with open('/dev/tty') as tty:
		rows, columns, xpixel, ypixel = struct.unpack(
			'HHHH', fcntl.ioctl(tty, termios.TIOCGWINSZ, b'\0' * 8)
		)
except Exception:
	sys.exit(1)
if not (rows and columns and xpixel and ypixel):
	sys.exit(1)
print(xpixel // columns, ypixel // rows, columns, rows)
PY
}

ask_cell_size() {
	# Raw, so the answer is not echoed and arrives without waiting for a return
	# that nobody is going to press. `time 3` is three tenths of a second, after
	# which a terminal that does not answer has answered.
	saved=$(stty -g 2>/dev/null) || return 1
	stty raw -echo min 0 time 3 2>/dev/null || return 1
	printf '%s[16t' "$esc" > /dev/tty
	reply=$(dd bs=1 count=16 2>/dev/null < /dev/tty)
	stty "$saved" 2>/dev/null
	# ESC [ 6 ; height ; width t
	echo "$reply" | awk -v RS='t' -F';' '/\[6/ { print $3, $2; exit }'
}

measure_terminal() {
	# tmux knows, and knows better than the ioctl does: it keeps the size of the
	# terminal it is attached to, while the pty it hands the shell is its own and
	# carries no pixels at all.
	if in_tmux; then
		size=$(tmux display -p '#{client_cell_width} #{client_cell_height} #{window_width} #{window_height}' 2>/dev/null || true)
		case "${size:-}" in
			[0-9]*\ [0-9]*\ [0-9]*\ [0-9]*)
				cell_w=${size%% *}
				rest=${size#* }
				cell_h=${rest%% *}
				rest=${rest#* }
				term_columns=${rest%% *}
				term_rows=${rest##* }
				;;
		esac
	fi

	[ "$cell_w" -gt 0 ] 2>/dev/null && [ "$cell_h" -gt 0 ] 2>/dev/null && return 0

	size=$(read_winsize || true)
	if [ -n "${size:-}" ]; then
		cell_w=${size%% *}
		rest=${size#* }
		cell_h=${rest%% *}
		rest=${rest#* }
		term_columns=${rest%% *}
		term_rows=${rest##* }
	fi

	[ "$term_columns" -gt 0 ] 2>/dev/null || term_columns=$(tput cols 2>/dev/null || echo 80)
	[ "$term_rows" -gt 0 ] 2>/dev/null || term_rows=$(tput lines 2>/dev/null || echo 24)

	if ! [ "$cell_w" -gt 0 ] 2>/dev/null || ! [ "$cell_h" -gt 0 ] 2>/dev/null; then
		asked=$(ask_cell_size 2>/dev/null || true)
		if [ -n "${asked:-}" ]; then
			cell_w=${asked%% *}
			cell_h=${asked##* }
		fi
	fi

	# Still nothing: a picture at a size nobody chose is worse than one at the
	# width of the window, which is at least a size that fits.
	[ "$cell_w" -gt 0 ] 2>/dev/null || cell_w=0
	[ "$cell_h" -gt 0 ] 2>/dev/null || cell_h=0
}

measure_terminal

# One graphics command: the keys, then the payload, wrapped for tmux when
# tmux is in the way.
emit() {
	keys="$1"
	payload="$2"
	if in_tmux; then
		# tmux passthrough: every ESC in the payload doubled, the whole thing
		# between `DCS tmux;` and `ST`.
		printf '%sPtmux;%s%s_G%s;%s%s%s\\%s\\' \
			"$esc" "$esc" "$esc" "$keys" "$payload" "$esc" "$esc" "$esc"
	else
		printf '%s_G%s;%s%s\\' "$esc" "$keys" "$payload" "$esc"
	fi
}

print_image() {
	source_file="$1"

	# PNG straight through; anything else converted, since the protocol's
	# direct format is PNG and `sips` is on every Mac.
	case "$source_file" in
		*.png|*.PNG) file="$source_file" ;;
		*)
			file="$(mktemp -t abydos-icat).png"
			sips -s format png "$source_file" --out "$file" >/dev/null 2>&1 || {
				echo "abydos-icat: cannot read $source_file" >&2
				return 1
			}
			;;
	esac

	# The payload, already split into the 4096-character pieces the protocol
	# asks for. Split once by `fold` rather than by taking a slice of a shell
	# variable per piece: `cut -c` re-scans the whole string every time, so a
	# five-megabyte picture — seven megabytes of base64, eighteen hundred
	# pieces — spent five minutes re-reading itself.
	chunks="$(mktemp -t abydos-icat-chunks)"
	base64 < "$file" | tr -d '\n' | fold -w 4096 > "$chunks"

	pixels=$(sips -g pixelWidth -g pixelHeight "$file" 2>/dev/null |
		awk '/pixelWidth/ {w=$2} /pixelHeight/ {h=$2} END {print w" "h}')
	image_width=${pixels%% *}
	image_height=${pixels##* }
	[ "${image_width:-0}" -gt 0 ] 2>/dev/null || image_width=0
	[ "${image_height:-0}" -gt 0 ] 2>/dev/null || image_height=0

	# The converted copy goes now, and not before the line above: its size is
	# what decides how many columns the picture takes, and asking a file that
	# has just been deleted answers nothing — which quietly turned every JPEG
	# into a picture the width of the window.
	[ "$file" = "$source_file" ] || rm -f "$file"

	# How large to draw it, in cells — both dimensions, worked out here.
	#
	# The protocol will take a width alone and keep the proportions, and then
	# only the terminal knows how many rows that came to, while this has to move
	# the cursor past them. Working it back out from the cell size is close and
	# not exact, and every cell it is out by is a blank line after the picture.
	# Sending both leaves nothing to guess: the terminal draws exactly the box
	# named here, and the cursor goes exactly that far.
	columns="$width"
	rows="$height"

	if [ "$cell_w" -gt 0 ] && [ "$cell_h" -gt 0 ] \
		&& [ "$image_width" -gt 0 ] && [ "$image_height" -gt 0 ]; then
		# Its own size, in cells, before anything is asked of it.
		natural_columns=$(( (image_width + cell_w - 1) / cell_w ))
		natural_rows=$(( (image_height + cell_h - 1) / cell_h ))

		if [ -n "$columns" ] && [ -z "$rows" ]; then
			rows=$(( natural_rows * columns / natural_columns ))
		elif [ -n "$rows" ] && [ -z "$columns" ]; then
			columns=$(( natural_columns * rows / natural_rows ))
		elif [ -z "$columns" ] && [ -z "$rows" ]; then
			columns="$natural_columns"
			rows="$natural_rows"
		fi

		# Inside the window, proportions kept. A photograph is thousands of
		# pixels across and a portrait one is taller than the screen; the first
		# scrolls off the right and the second scrolls off the top before
		# anybody has seen it. Only when no size was asked for: somebody who
		# says -w 200 means it.
		if [ -z "$width" ] && [ -z "$height" ]; then
			if [ "$columns" -gt "$term_columns" ]; then
				rows=$(( rows * term_columns / columns ))
				columns="$term_columns"
			fi
			# One line short of the window, so the prompt that follows is not
			# already scrolling the top of the picture away.
			fit_rows=$(( term_rows - 1 ))
			[ "$fit_rows" -gt 0 ] || fit_rows=1
			if [ "$rows" -gt "$fit_rows" ]; then
				columns=$(( columns * fit_rows / rows ))
				rows="$fit_rows"
			fi
		fi
	fi

	# Nothing known about the cells: the width of the window is the one size
	# that is certain to fit, and the height is a guess from the proportions.
	if [ -z "$columns" ] && [ -z "$rows" ]; then
		columns="$term_columns"
	fi

	[ "${columns:-0}" -gt 0 ] 2>/dev/null || columns=1
	[ "${rows:-0}" -gt 0 ] 2>/dev/null || rows=""

	# An id the placeholder cells can name. It rides in their foreground colour,
	# so it is kept inside three bytes and away from zero.
	image_id=$(( ($$ % 16777213) + 1 ))

	# A height, whatever else is known. With placeholders the picture is exactly
	# as tall as the rows written for it, so there always has to be a number
	# here — and the terminal is told the same one.
	if [ -z "$rows" ]; then
		if [ "$image_width" -gt 0 ] && [ "$image_height" -gt 0 ]; then
			# A cell is about twice as tall as it is wide, which is the only
			# thing left to go on when nothing reported one.
			rows=$(( (image_height * columns) / (image_width * 2) + 1 ))
		else
			rows=10
		fi
	fi
	[ "$rows" -gt 0 ] 2>/dev/null || rows=1

	# f=100: the payload is a PNG. a=T: transmit and place it. U=1: a *virtual*
	# placement — one belonging to no position, shown by writing placeholder
	# characters afterwards. q=2: say nothing back.
	#
	# This is the form kitty's own `icat` uses, and the reason is the one that
	# was costing us pictures. Placing at the cursor means the terminal decides
	# how many rows the picture covers and this has to arrive at the same number
	# independently, from a cell size read out of an ioctl — and where that
	# number is wrong the picture is followed by a field of blank lines, or
	# scrolls away before it can be looked at. With placeholders the cells are
	# written here: the picture is exactly as tall as the rows put on the
	# screen, because it *is* those rows. Nothing is guessed and nothing has to
	# agree.
	#
	# It is also the form that survives tmux, which moves the characters and
	# therefore moves the picture.
	keys="f=100,a=T,U=1,q=2,i=$image_id,c=$columns,r=$rows"

	# What it decided, for working out a picture that came out the wrong size or
	# a prompt that landed in the wrong place.
	[ -z "${ABYDOS_ICAT_DEBUG:-}" ] || echo "abydos-icat: image ${image_width}x${image_height}px" \
		"cell ${cell_w}x${cell_h}px term ${term_columns} cols" \
		"-> c=${columns:-none} rows=${rows}" >&2

	# One piece at a time, with `m=1` on every one but the last — which is why
	# each is held back until the next has been read: the last one is only
	# recognisable by there being nothing after it.
	first=1
	send_chunk() {
		if [ "$first" -eq 1 ]; then
			emit "$keys,m=$2" "$1"
			first=0
		else
			emit "m=$2" "$1"
		fi
	}

	# `|| [ -n "$piece" ]` because the last piece has no newline after it.
	#
	# `base64 | tr -d '\n'` produces one unterminated line, so `fold` ends the
	# same way, and `read` returns false on a final line with no newline even
	# though it read one. The body is then skipped and that piece is never sent
	# — so every picture arrived missing its last few kilobytes and no terminal
	# could decode it. It went unnoticed because the one image this was tried on
	# encoded to exactly fifty-seven whole chunks.
	held=""
	while IFS= read -r piece || [ -n "$piece" ]; do
		[ -z "$held" ] || send_chunk "$held" 1
		held="$piece"
	done < "$chunks"
	[ -z "$held" ] || send_chunk "$held" 0
	rm -f "$chunks"

	# The picture itself: rows of placeholder cells.
	#
	# Each cell is U+10EEEE. The first of a row carries two combining marks
	# saying which row and column of the picture it is; the rest carry none and
	# continue from it, which is what the protocol says and what keeps this to a
	# few bytes a row. The foreground colour is the image's id.
	#
	# Written by python3 because a POSIX shell has no way to emit a codepoint by
	# number — `printf '\u0305'` is not in bash 3.2, which is what /bin/sh is
	# here — and the diacritics are three-byte sequences nobody should be
	# pasting into a script by hand.
	"$PYTHON" - "$columns" "$rows" "$image_id" <<'PY'
import sys

columns, rows, image_id = (int(argument) for argument in sys.argv[1:4])

# kitty's row/column diacritics: the index into this list is the number.
DIACRITICS = [
	0x0305, 0x030D, 0x030E, 0x0310, 0x0312, 0x033D, 0x033E, 0x033F, 0x0346,
	0x034A, 0x034B, 0x034C, 0x0350, 0x0351, 0x0352, 0x0357, 0x035B, 0x0363,
	0x0364, 0x0365, 0x0366, 0x0367, 0x0368, 0x0369, 0x036A, 0x036B, 0x036C,
	0x036D, 0x036E, 0x036F, 0x0483, 0x0484, 0x0485, 0x0486, 0x0487, 0x0592,
	0x0593, 0x0594, 0x0595, 0x0597, 0x0598, 0x0599, 0x059C, 0x059D, 0x059E,
	0x059F, 0x05A0, 0x05A1, 0x05A8, 0x05A9, 0x05AB, 0x05AC, 0x05AF, 0x05C4,
	0x0610, 0x0611, 0x0612, 0x0613, 0x0614, 0x0615, 0x0616, 0x0617, 0x0657,
	0x0658, 0x0659, 0x065A, 0x065B, 0x065D, 0x065E, 0x06D6, 0x06D7, 0x06D8,
	0x06D9, 0x06DA, 0x06DB, 0x06DC, 0x06DF, 0x06E0, 0x06E1, 0x06E2, 0x06E4,
	0x06E7, 0x06E8, 0x06EB, 0x06EC, 0x0730, 0x0732, 0x0733, 0x0735, 0x0736,
	0x073A, 0x073D, 0x073F, 0x0740, 0x0741, 0x0743, 0x0745, 0x0747, 0x0749,
	0x074A, 0x07EB, 0x07EC, 0x07ED, 0x07EE, 0x07EF, 0x07F0, 0x07F1, 0x07F3,
	0x0816, 0x0817, 0x0818, 0x0819, 0x081B, 0x081C, 0x081D, 0x081E, 0x081F,
	0x0820, 0x0821, 0x0822, 0x0823, 0x0825, 0x0826, 0x0827, 0x0829, 0x082A,
	0x082B, 0x082C, 0x082D, 0x0951, 0x0953, 0x0954, 0x0F82, 0x0F83, 0x0F86,
	0x0F87, 0x135D, 0x135E, 0x135F, 0x17DD, 0x193A, 0x1A17, 0x1A75, 0x1A76,
	0x1A77, 0x1A78, 0x1A79, 0x1A7A, 0x1A7B, 0x1A7C, 0x1B6B, 0x1B6D, 0x1B6E,
	0x1B6F, 0x1B70, 0x1B71, 0x1B72, 0x1B73, 0x1CD0, 0x1CD1, 0x1CD2, 0x1CDA,
	0x1CDB, 0x1CE0, 0x1DC0, 0x1DC1, 0x1DC3, 0x1DC4, 0x1DC5, 0x1DC6, 0x1DC7,
	0x1DC8, 0x1DC9, 0x1DCB, 0x1DCC, 0x1DD1, 0x1DD2, 0x1DD3, 0x1DD4, 0x1DD5,
	0x1DD6, 0x1DD7, 0x1DD8, 0x1DD9, 0x1DDA, 0x1DDB, 0x1DDC, 0x1DDD, 0x1DDE,
	0x1DDF, 0x1DE0, 0x1DE1, 0x1DE2, 0x1DE3, 0x1DE4, 0x1DE5, 0x1DE6, 0x1DFE,
	0x20D0, 0x20D1, 0x20D4, 0x20D5, 0x20D6, 0x20D7, 0x20DB, 0x20DC, 0x20E1,
	0x20E7, 0x20E9, 0x20F0, 0x2CEF, 0x2CF0, 0x2CF1, 0x2DE0, 0x2DE1, 0x2DE2,
	0x2DE3, 0x2DE4, 0x2DE5, 0x2DE6, 0x2DE7, 0x2DE8, 0x2DE9, 0x2DEA, 0x2DEB,
	0x2DEC, 0x2DED, 0x2DEE, 0x2DEF, 0x2DF0, 0x2DF1, 0x2DF2, 0x2DF3, 0x2DF4,
	0x2DF5, 0x2DF6, 0x2DF7, 0x2DF8, 0x2DF9, 0x2DFA, 0x2DFB, 0x2DFC, 0x2DFD,
	0x2DFE, 0x2DFF, 0xA66F, 0xA67C, 0xA67D, 0xA6F0, 0xA6F1, 0xA8E0, 0xA8E1,
	0xA8E2, 0xA8E3, 0xA8E4, 0xA8E5, 0xA8E6, 0xA8E7, 0xA8E8, 0xA8E9, 0xA8EA,
	0xA8EB, 0xA8EC, 0xA8ED, 0xA8EE, 0xA8EF, 0xA8F0, 0xA8F1, 0xAAB0, 0xAAB2,
	0xAAB3, 0xAAB7, 0xAAB8, 0xAABE, 0xAABF, 0xAAC1, 0xFE20, 0xFE21, 0xFE22,
	0xFE23, 0xFE24, 0xFE25, 0xFE26, 0x10A0F, 0x10A38, 0x1D185, 0x1D186,
	0x1D187, 0x1D188, 0x1D189, 0x1D1AA, 0x1D1AB, 0x1D1AC, 0x1D1AD, 0x1D242,
	0x1D243, 0x1D244,
]

PLACEHOLDER = chr(0x10EEEE)
colour = "\033[38;2;{};{};{}m".format(
	(image_id >> 16) & 0xFF, (image_id >> 8) & 0xFF, image_id & 0xFF
)

out = [colour]
for row in range(rows):
	# Only the first cell says where it is; the rest continue it.
	line = PLACEHOLDER + chr(DIACRITICS[row]) + chr(DIACRITICS[0])
	line += PLACEHOLDER * (columns - 1)
	out.append(line + "\n")
out.append("\033[39m")
sys.stdout.write("".join(out))
PY
}

status=0
for image in "$@"; do
	if [ ! -f "$image" ]; then
		echo "abydos-icat: $image does not exist" >&2
		status=1
		continue
	fi
	print_image "$image" || status=1
done
exit "$status"
